server:
  host: "0.0.0.0"
  port: 8080

logger:
  level: "info"
  format: "json"

security:
  jwt_secret: "dev-secret-change-in-prod"
  jwt_expire: 86400

kubevirt:
  enabled: true
  kubeconfig: ""
  namespace: "default"

# Uncomment for local MySQL. In-cluster config is rendered by helm-charts (see config/README.md).
# database:
#   driver: mysql
#   dsn: "virtfoundry:virtfoundry@tcp(localhost:3306)/virtfoundry?charset=utf8mb4"

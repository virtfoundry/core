server:
  host: "0.0.0.0"
  port: 8080

logger:
  level: "info"
  format: "json"

# JWT_SECRET must be supplied via env / Kubernetes Secret.
# The server refuses to start if it is empty, shorter than 32 chars, or a known default
# (change-me-in-production / dev-secret-change-in-prod).
security:
  jwt_expire: 86400
  # Browser origins allowed to open the /ws/events WebSocket. The request host
  # is always accepted (the UI is served same-origin), so this is only needed
  # when the UI is hosted on a different origin than the API.
  # allowed_origins:
  #   - "https://console.example.com"
  # Login brute-force protection: failures within `window` beyond the max
  # temporarily block the username / client IP for `lockout` (HTTP 429).
  # login_throttle:
  #   user_max_failures: 5
  #   ip_max_failures: 20
  #   window: 10m
  #   lockout: 5m

kubevirt:
  enabled: true
  kubeconfig: ""
  namespace: "default"

# VM defaults applied during template seeding. The seed CloudInitNoCloud payload
# marks the password as expired (chpasswd.expire: True), so PAM forces the user
# to pick a new one on first login. Empty falls back to "ubuntu".
# vm:
#   default_password: ""

# Local dev store: memory (default) or kubernetes (requires CRDs + KUBECONFIG).
# database:
#   driver: kubernetes
#   kubeconfig: ""

server:
  host: "0.0.0.0"
  port: 8080

logger:
  level: "info"
  format: "json"

# JWT_SECRET must be supplied via env / Kubernetes Secret.
# The server refuses to start if it is empty, shorter than 32 chars, or a known default
# (change-me-in-production / dev-secret-change-in-prod).
security:
  jwt_expire: 86400
  # Browser origins allowed for CORS and for /ws/events + /ws/console.
  # The request host is always accepted (the UI is served same-origin via the
  # nginx proxy), so this is only needed when the UI is hosted on a different
  # origin than the API. Empty fails closed for cross-origin — there is no
  # Access-Control-Allow-Origin: *. Env override: VIRTFOUNDRY_ALLOWED_ORIGINS
  # (comma separated).
  # allowed_origins:
  #   - "https://console.example.com"
  # Login brute-force protection: failures within `window` beyond the max
  # temporarily block the username / client IP for `lockout` (HTTP 429).
  # login_throttle:
  #   user_max_failures: 5
  #   ip_max_failures: 20
  #   window: 10m
  #   lockout: 5m
  # Hosts CDI may download tenant-supplied ISO URLs from. HTTPS on port 443 is
  # always required, and private / link-local / localhost / *.svc / *.internal
  # targets are always refused (SSRF). Empty keeps the built-in list of public
  # ISO mirrors and object storage endpoints — add your own mirror here.
  # Env overrides: VIRTFOUNDRY_ISO_ALLOWED_HOSTS (comma separated),
  # VIRTFOUNDRY_ISO_DISABLE_HTTP_IMPORT=1.
  # iso_import:
  #   allowed_hosts:
  #     - "iso.mylab.example.com"
  #     - "*.blob.core.windows.net"
  #   disable_http_import: false

kubevirt:
  enabled: true
  kubeconfig: ""
  namespace: "default"

# VM defaults applied during template seeding. When set, the seed CloudInitNoCloud
# payload marks the password as expired (chpasswd.expire: True), so PAM forces the
# user to pick a new one on first login. Empty (default) means no password is
# seeded — Linux VM create requires ssh_key_id or cloud_init_password (issue #97).
# Never leave this unset and expect a published default such as "ubuntu".
# vm:
#   default_password: ""

# Local dev store: memory (default) or kubernetes (requires CRDs + KUBECONFIG).
# database:
#   driver: kubernetes
#   kubeconfig: ""
